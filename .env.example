# 1. Make a copy of this file called ".env" (with nothing before the dot)
# 2. Paste your own values from the Spotify Developer Dashboard below
# 3. Never share or upload your .env file
SPOTIFY_CLIENT_ID=paste-your-client-id-here
SPOTIFY_CLIENT_SECRET=paste-your-client-secret-here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Your Bose app login (for bose_now_playing.py)
BOSE_EMAIL=you@example.com
BOSE_PASSWORD=your-bose-password
